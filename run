#!/usr/bin/env python3
"""The single public entry point; usable from any working directory."""
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
os.environ.setdefault("PYTHONDONTWRITEBYTECODE", "1")
environment = Path(os.environ.get(
    "MCP_EXPERIMENT_ENV", ROOT / "configs" / "environment.local.json"))
if environment.is_file():
    configured = json.loads(environment.read_text()).get("python")
    if configured and Path(sys.executable).absolute() != Path(configured).absolute():
        os.execv(configured, [configured, str(Path(__file__).resolve()), *sys.argv[1:]])

from exp_core.cli import main

sys.exit(main())
